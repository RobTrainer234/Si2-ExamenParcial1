APP_ENV=development
APP_NAME=FashionStore API
API_V1_PREFIX=/api/v1

POSTGRES_DB=fashionstore
POSTGRES_USER=fashionstore
POSTGRES_PASSWORD=change_me
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=fashionstore
DATABASE_USER=fashionstore
DATABASE_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://fashionstore:change_me@postgres:5432/fashionstore

JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

BACKEND_PORT=8000
WEB_PORT=4200
FRONTEND_URL=http://localhost:4200
API_URL=http://localhost:8000

SEED_ADMIN_EMAIL=admin@fashionstore.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Google Gemini AI (Sofía Asistente Virtual & Reportes con IA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Opcional si se usa Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Pasarela de Pagos Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=bob


# Servicio Transaccional de Correos (Brevo / Sendinblue)
# Pega aquí tu API Key (xkeysib-...) y el correo remitente verificado en Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="FashionStore Cloud"
