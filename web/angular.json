{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "fashionstore-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["zone.js"],
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "assets" },
              { "glob": "favicon.ico", "input": "src", "output": "" },
              { "glob": "manifest.webmanifest", "input": "src", "output": "" }
            ],
            "styles": ["src/styles.css"],
            "optimization": false
          },
          "configurations": {
            "development": { "optimization": false, "sourceMap": true },
            "production": {
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json", "buildTarget": "fashionstore-web:build:development" },
          "configurations": {
            "production": { "buildTarget": "fashionstore-web:build:production" },
            "development": { "buildTarget": "fashionstore-web:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
